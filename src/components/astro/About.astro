---
import { t, type Locale, type UiKey } from '../../i18n/utils';
import type { ProfileData } from '../../lib/types';

interface Props {
  lang: Locale;
  profile: ProfileData;
}
const { lang, profile } = Astro.props;
const groups = (['frontend', 'backend', 'tools', 'practices'] as const)
  .map((key) => ({ key, label: t(lang, `stack.${key}` as UiKey), items: profile.stack[key] }))
  .filter((g) => g.items.length > 0);
---

<section id="about" aria-labelledby="about-title" class="scroll-mt-14">
  <div class="chapter chapter-inner">
    <h2 id="about-title" class="sr-only">
      {t(lang, 'about.title')}
    </h2>
    <p class="fade-up max-w-[70ch] text-[clamp(1.25rem,2vw,1.85rem)] leading-[1.4] lg:max-w-none lg:columns-2 lg:gap-12">
      {profile.bio}
    </p>
    {groups.length > 0 && (
      <ul class="fade-up mt-16 grid gap-x-12 gap-y-8 sm:grid-cols-2">
        {groups.map((g) => (
          <li>
            <h3 class="heavy text-lg">{g.label}</h3>
            <p class="mt-1 leading-relaxed text-muted">{g.items.join(', ')}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
