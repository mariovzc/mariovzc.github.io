---
import { t, type Locale } from '../../i18n/utils';
import type { ProfileData } from '../../lib/types';

interface Props {
  lang: Locale;
  profile: ProfileData;
}
const { lang, profile } = Astro.props;
const word = t(lang, 'contact.word');
// One word is the button: size the verb so it spans the viewport on one line.
const wordSize = `${(94 / (word.length * 0.62)).toFixed(1)}vw`;
---

<section id="contact" aria-labelledby="contact-title" class="scroll-mt-14">
  <h2 id="contact-title" class="sr-only">
    {t(lang, 'contact.title')}
  </h2>
  <a
    href={`mailto:${profile.contact.email}`}
    class="cta-band relative flex min-h-[60svh] flex-col justify-between overflow-hidden"
  >
    <div class="fade-up flex items-start justify-between gap-8 px-4 pt-8 sm:px-6">
      <p class="max-w-[32ch] text-lg leading-snug font-semibold sm:text-xl">
        {t(lang, 'contact.text')}
        <span class="mt-1 block font-bold break-all">{profile.contact.email}</span>
      </p>
      <svg
        width="48"
        height="48"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="square"
        aria-hidden="true"
        class="mt-1 shrink-0"
      >
        <path d="M7 17 17 7M8 7h9v9" />
      </svg>
    </div>
    <span
      aria-hidden="true"
      class="heavy block whitespace-nowrap pb-3 pl-2 leading-none tracking-[-0.03em]"
      style={`font-size: ${wordSize}`}
    >
      {word}
    </span>
  </a>
</section>

<style>
  .cta-band {
    background: var(--field);
    color: var(--on-field);
    transition: none;
  }
  .cta-band:hover,
  .cta-band:focus-visible {
    background: var(--on-field);
    color: var(--field);
  }
</style>
