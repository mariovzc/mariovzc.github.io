---
import { t, type Locale } from '../../i18n/utils';
import type { ProfileData } from '../../lib/types';

interface Props {
  lang: Locale;
  profile: ProfileData;
}
const { lang, profile } = Astro.props;
const { email, github, linkedin, x } = profile.contact;
const socials = [
  { label: 'GitHub', href: github },
  { label: 'LinkedIn', href: linkedin },
  { label: 'X', href: x },
].filter((s): s is { label: string; href: string } => Boolean(s.href));
---

<section id="contact" aria-labelledby="contact-title" class="fade-up scroll-mt-20 py-10 sm:py-12">
  <div class="hero-surface relative overflow-hidden rounded-block px-7 py-12 sm:px-12 sm:py-16">
    <div class="relative">
      <p class="text-xs font-bold uppercase tracking-[0.14em]">{t(lang, 'section.contact')}</p>
      <h2 id="contact-title" class="heavy mt-3 text-3xl sm:text-5xl">
        {t(lang, 'contact.title')}
      </h2>
      <p class="mt-4 max-w-xl text-lg">{t(lang, 'contact.text')}</p>
      <a href={`mailto:${email}`} class="pill pill-white mt-8 px-6 py-3 text-base break-all">
        {email}
      </a>
      {socials.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" class="pill pill-outline-white">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
