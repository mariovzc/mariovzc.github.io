---
import { t, type Locale } from '../../i18n/utils';
import type { ProfileData } from '../../lib/types';

interface Props {
  lang: Locale;
  profile: ProfileData;
}
const { lang, profile } = Astro.props;
const { education, certifications } = profile;
---

{(education.length > 0 || certifications.length > 0) && (
  <section id="education" aria-labelledby="education-title" class="scroll-mt-14">
    <div class="chapter chapter-inner">
      <h2 id="education-title" class="fade-up t-large max-w-[14em] text-balance">
        {t(lang, 'education.title')}
      </h2>
      <div class="fade-up mt-14 grid gap-x-14 gap-y-12 lg:grid-cols-2">
        {education.length > 0 && (
          <ul class="flex flex-col gap-9">
            {education.map((e) => (
              <li>
                <h3 class="heavy text-2xl">{e.institution}</h3>
                <p class="mt-1 text-lg">{e.degree}</p>
                <p class="mt-1 font-semibold text-muted">
                  {e.start}
                  {e.end ? ` – ${e.end}` : ''}
                </p>
              </li>
            ))}
          </ul>
        )}
        {certifications.length > 0 && (
          <div>
            <h3 class="heavy text-2xl">{t(lang, 'education.certifications')}</h3>
            <ul class="mt-5 flex flex-col gap-5">
              {certifications.map((c) => (
                <li>
                  {c.url ? (
                    <a
                      href={c.url}
                      target="_blank"
                      rel="noopener"
                      class="heavy text-lg underline-offset-4 hover:text-accent hover:underline"
                    >
                      {c.name}
                    </a>
                  ) : (
                    <p class="heavy text-lg">{c.name}</p>
                  )}
                  <p class="text-muted">
                    {c.issuer} · {c.year}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
)}
