---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { t, type Locale } from '../../i18n/utils';
import type { ProfileData } from '../../lib/types';

interface Props {
  lang: Locale;
  profile: ProfileData;
}
const { lang, profile } = Astro.props;
const { education, certifications } = profile;
---

{(education.length > 0 || certifications.length > 0) && (
  <Section id="education" title={t(lang, 'education.title')}>
    {education.length > 0 && (
      <ul class="grid gap-5 md:grid-cols-2">
        {education.map((e) => (
          <li class="tile tile-hover p-7">
            <span class="chip bg-chip-green-bg text-chip-green">
              <Icon name="cap" />
            </span>
            <h3 class="heavy mt-5 text-xl">{e.institution}</h3>
            <p class="mt-2 text-muted">{e.degree}</p>
            <p class="mt-1 text-sm font-semibold text-muted">
              {e.start}
              {e.end ? ` – ${e.end}` : ''}
            </p>
          </li>
        ))}
      </ul>
    )}
    {certifications.length > 0 && (
      <div class:list={[education.length > 0 && 'mt-10']}>
        <h3 class="heavy mb-4 text-xl">{t(lang, 'education.certifications')}</h3>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {certifications.map((c) => (
            <li class="tile tile-hover flex items-start gap-3 p-5">
              <span class="chip bg-chip-blue-bg text-chip-blue">
                <Icon name="badge" />
              </span>
              <div>
                {c.url ? (
                  <a href={c.url} target="_blank" rel="noopener" class="heavy hover:underline">
                    {c.name}
                  </a>
                ) : (
                  <p class="heavy">{c.name}</p>
                )}
                <p class="text-sm text-muted">
                  {c.issuer} · {c.year}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
  </Section>
)}
