---
import { t, type Locale } from '../../i18n/utils';
import type { ProfileData } from '../../lib/types';

interface Props {
  lang: Locale;
  profile: ProfileData;
}
const { lang, profile } = Astro.props;
---

{profile.experience.length > 0 && (
  <section id="experience" aria-labelledby="experience-title" class="scroll-mt-14 bg-surface">
    <div class="chapter chapter-inner">
      <h2 id="experience-title" class="fade-up t-large">
        {t(lang, 'experience.title')}
      </h2>
      <ol class="fade-up mt-14 flex flex-col gap-14">
        {profile.experience.map((e) => (
          <li class="grid gap-x-10 gap-y-2 lg:grid-cols-12">
            <p class="font-semibold text-muted lg:col-span-2">
              {e.end === e.start
                ? e.start
                : `${e.start} – ${e.end ?? t(lang, 'experience.present')}`}
            </p>
            <div class="max-w-3xl lg:col-span-10">
              <h3 class="heavy text-2xl">
                {e.role} · {e.company}
              </h3>
              <p class="mt-2 text-lg leading-relaxed">{e.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
