---
interface Props {
  name: string;
  fullName?: string;
}

const { name, fullName } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 bg-[var(--footer-bg)] text-[#a1a1a6]">
  <div class="mx-auto max-w-6xl px-4 py-10 text-center text-sm sm:px-6">
    <p>
      © {year} <span class="heavy text-[#f5f5f7]">{fullName ?? name}</span>
    </p>
  </div>
</footer>
