---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
  name: string;
}

const { lang, name } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-8 text-sm text-muted sm:flex-row sm:justify-between sm:px-6">
    <p>
      © {year} {name}
    </p>
    <p>{t(lang, 'footer.built')}</p>
  </div>
</footer>
