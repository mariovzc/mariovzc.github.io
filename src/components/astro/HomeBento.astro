---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { localizePath, t, type Locale } from '../../i18n/utils';
import type { LocalizedProject } from '../../lib/projects';
import type { ProjectEntry } from '../../lib/site-data';
import type { ProfileData } from '../../lib/types';
import { bentoSpans } from '../../lib/bento';
import { remainingStackCount, stackHighlights } from '../../lib/profile';

interface Props {
  lang: Locale;
  profile: ProfileData;
  featured?: LocalizedProject<ProjectEntry>;
  years: number | null;
}
const { lang, profile, featured, years } = Astro.props;
const home = localizePath('/', lang);
const stack = stackHighlights(profile);
const moreStack = remainingStackCount(profile.stack, stack);
// 1x1 tiles present (stack?, years?, terminal, contact); spans keep rows full.
const singles = (stack.length > 0 ? 1 : 0) + (years !== null ? 1 : 0) + 2;
const spans = bentoSpans(singles, Boolean(featured));
// Literal class names so Tailwind generates them.
const smSpan = { 1: 'sm:col-span-1', 2: 'sm:col-span-2' } as const;
const lgSpan = { 1: 'lg:col-span-1', 2: 'lg:col-span-2', 4: 'lg:col-span-4' } as const;
const f = featured?.entry.data;
---

<section class="grid gap-4 py-6 sm:grid-cols-2 sm:py-8 lg:grid-cols-4 lg:gap-5">
  <div class="hero-surface fade-up relative flex min-h-80 flex-col justify-between overflow-hidden rounded-block p-7 sm:col-span-2 sm:p-9 lg:row-span-2">
    <p class="text-xs font-bold uppercase tracking-[0.14em]">{profile.role}</p>
    <div class="mt-16">
      <h1 class="heavy text-5xl leading-[1.02] sm:text-6xl">{profile.name}</h1>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${home}#work`} class="pill pill-white px-5 py-2.5">
          {t(lang, 'hero.viewWork')}
        </a>
        <a href={`${home}#contact`} class="pill pill-outline-white px-5 py-2.5">
          {t(lang, 'hero.contact')}
        </a>
      </div>
    </div>
  </div>

  <div class="tile fade-up flex flex-col justify-center p-7 sm:col-span-2" style="--delay:60ms">
    <p class="heavy text-2xl leading-tight sm:text-3xl">{profile.headline}</p>
    {profile.availability && (
      <p class="pill pill-soft mt-5 self-start">
        <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
        {profile.availability}
      </p>
    )}
  </div>

  {stack.length > 0 && (
    <div class="tile fade-up p-6" style="--delay:120ms">
      <span class="chip bg-chip-purple-bg text-chip-purple">
        <Icon name="code" />
      </span>
      <p class="mt-4 text-sm font-semibold text-muted">{t(lang, 'stack.core')}</p>
      <ul class="mt-2 flex flex-wrap gap-1.5">
        {stack.map((s) => (
          <li class="pill pill-neutral px-2.5 py-0.5 text-xs">{s}</li>
        ))}
        {moreStack > 0 && (
          <li>
            <a
              href={`${home}#about`}
              data-testid="stack-more"
              class="pill pill-soft px-2.5 py-0.5 text-xs font-semibold"
            >
              +{moreStack} {t(lang, 'stack.more')}
            </a>
          </li>
        )}
      </ul>
    </div>
  )}

  {years !== null && (
    <div class="tile fade-up p-6" style="--delay:160ms">
      <span class="chip bg-chip-orange-bg text-chip-orange">
        <Icon name="spark" />
      </span>
      <p class="heavy mt-4 text-5xl">{years}+</p>
      <p class="mt-1 text-sm font-semibold text-muted">{t(lang, 'stats.years')}</p>
    </div>
  )}

  <div
    class:list={[
      'tile-dark fade-up p-6 font-mono text-sm leading-relaxed',
      lgSpan[spans.terminalLg],
    ]}
    style="--delay:200ms"
  >
    <div class="mb-4 flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="size-2.5 rounded-full bg-[#28c840]"></span>
    </div>
    <p>
      <span class="text-[#30d158]">$</span> whoami
    </p>
    <p class="text-[#98989d]">{profile.role}</p>
    {profile.location && (
      <>
        <p class="mt-2">
          <span class="text-[#30d158]">$</span> location
        </p>
        <p class="text-[#98989d]">{profile.location}</p>
      </>
    )}
  </div>

  <div
    class:list={[
      'tile fade-up flex flex-col p-6',
      smSpan[spans.contactSm],
      lgSpan[spans.contactLg],
    ]}
    style="--delay:240ms"
  >
    <span class="chip bg-chip-blue-bg text-chip-blue">
      <Icon name="mail" />
    </span>
    <p class="mt-4 text-sm font-semibold text-muted">{t(lang, 'nav.contact')}</p>
    <a
      href={`mailto:${profile.contact.email}`}
      class="mt-1 font-bold break-all text-accent underline-offset-4 hover:underline"
    >
      {profile.contact.email}
    </a>
  </div>

  {featured && f && (
    <a
      href={localizePath(`/projects/${featured.slug}/`, lang)}
      class:list={[
        'tile tile-hover fade-up group flex flex-col overflow-hidden sm:col-span-2 sm:flex-row',
        lgSpan[spans.featuredLg],
      ]}
      style="--delay:280ms"
    >
      <Image
        src={f.cover}
        alt={f.coverAlt}
        widths={[480, 800]}
        sizes="(min-width: 1024px) 560px, (min-width: 640px) 50vw, 100vw"
        format="webp"
        class="aspect-[16/10] w-full object-cover sm:aspect-auto sm:w-1/2"
      />
      <div class="flex flex-1 flex-col justify-center p-6">
        <p class="eyebrow">{t(lang, 'bento.featured')}</p>
        <p class="heavy mt-2 text-xl" lang={featured.contentLang}>
          {f.title}
        </p>
        <p class="mt-1 line-clamp-2 text-sm text-muted" lang={featured.contentLang}>
          {f.summary}
        </p>
        {f.confidential && (
          <span
            data-testid="confidential-badge"
            class="pill mt-3 inline-flex items-center gap-1.5 bg-chip-orange-bg px-2.5 py-0.5 text-xs font-semibold text-chip-orange"
          >
            <Icon name="lock" />
            {t(lang, 'project.confidential')}
          </span>
        )}
        <p class="mt-3 text-sm font-bold text-accent">{t(lang, 'projects.view')} →</p>
      </div>
    </a>
  )}
</section>
