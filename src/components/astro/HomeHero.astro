---
import { localizePath, t, type Locale } from '../../i18n/utils';
import type { ProfileData } from '../../lib/types';
import { splitHeadline } from '../../lib/profile';

interface Props {
  lang: Locale;
  profile: ProfileData;
}
const { lang, profile } = Astro.props;
const home = localizePath('/', lang);
const { main, lead } = splitHeadline(profile.headline);
const mailto = `mailto:${profile.contact.email}?subject=${encodeURIComponent(t(lang, 'hero.subject'))}`;
---

<section
  aria-label={profile.name}
  class="flex min-h-[calc(100svh-3.75rem)] flex-col justify-between gap-14 py-10 sm:py-14"
>
  <div class="chapter-inner fade-up">
    <h1 class="t-display text-balance">{main}</h1>
    {lead && <p class="t-display text-balance text-accent">{lead}</p>}
  </div>
  <div
    class="chapter-inner fade-up flex flex-wrap items-end justify-between gap-x-14 gap-y-9"
    style="--delay:120ms"
  >
    <p class="max-w-[38ch] text-lg leading-relaxed">
      <strong class="font-bold">{profile.name}</strong>, {profile.role} — {profile.location}.
      {profile.availability && ` ${profile.availability}.`}
    </p>
    <div class="flex flex-wrap items-center gap-7">
      <a href={`${home}#work`} class="font-bold underline underline-offset-[5px] hover:text-accent">
        {t(lang, 'hero.viewWork')}
      </a>
      <a href={mailto} class="btn px-6 py-3.5 text-base">
        {t(lang, 'hero.cta')}
      </a>
    </div>
  </div>
</section>
