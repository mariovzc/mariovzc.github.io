---
import { localizePath, t, type Locale } from '../../i18n/utils';
import type { LocalizedProject } from '../../lib/projects';
import type { ProjectEntry } from '../../lib/site-data';
import type { ProfileData } from '../../lib/types';
import { splitHeadline } from '../../lib/profile';

interface Props {
  lang: Locale;
  profile: ProfileData;
  featured?: LocalizedProject<ProjectEntry>;
  years: number | null;
}
const { lang, profile, featured, years } = Astro.props;
const home = localizePath('/', lang);
const { main, lead } = splitHeadline(profile.headline);
const mailto = `mailto:${profile.contact.email}?subject=${encodeURIComponent(t(lang, 'hero.subject'))}`;
const facts = [
  ...(years !== null ? [{ value: `${years}+`, label: t(lang, 'stats.years') }] : []),
  ...profile.heroFacts,
  ...(profile.location
    ? [{ value: profile.location.split(',')[0]!, label: profile.availability ?? profile.location }]
    : []),
];
const steps = [
  { text: t(lang, 'pipeline.in') },
  { text: t(lang, 'pipeline.llm'), note: t(lang, 'pipeline.model') },
  { text: t(lang, 'pipeline.review') },
  { text: t(lang, 'pipeline.out') },
];
---

<section aria-label={profile.name} class="py-12 sm:py-20">
  <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="fade-up lg:col-span-7">
      <h1 class="heavy text-[clamp(2.75rem,5.6vw,5.25rem)] leading-[0.98] tracking-[-0.04em] text-balance">
        {main}
      </h1>
      <p class="mt-7 max-w-[40ch] text-lg leading-relaxed sm:text-xl">
        {lead && (
          <>
            {lead} — {t(lang, 'hero.by')}{' '}
          </>
        )}
        <strong class="font-bold">{profile.name}</strong>, {profile.role}.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-5">
        <a href={mailto} class="pill pill-accent px-6 py-3.5 text-base font-extrabold">
          {t(lang, 'hero.cta')}
        </a>
        <a
          href={`${home}#work`}
          class="font-bold underline underline-offset-[5px] hover:text-accent"
        >
          {t(lang, 'hero.viewWork')}
        </a>
      </div>
    </div>

    {featured && (
      <a
        href={localizePath(`/projects/${featured.slug}/`, lang)}
        aria-label={`${t(lang, 'pipeline.label')} — ${t(lang, 'pipeline.cta')}`}
        class="tile tile-hover fade-up block p-6 sm:p-7 lg:col-span-5"
        style="--delay:80ms"
        data-testid="hero-pipeline"
      >
        <ol class="flex flex-col gap-2.5">
          {steps.map((s, i) => (
            <>
              {i > 0 && (
                <li aria-hidden="true" class="pl-5 leading-none text-muted">
                  ↓
                </li>
              )}
              <li
                class:list={[
                  'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 rounded-xl px-5 py-4 font-bold',
                  s.note ? 'bg-accent text-on-accent' : 'bg-bg',
                ]}
              >
                <span>{s.text}</span>
                {s.note && <span class="text-sm font-semibold whitespace-nowrap">{s.note}</span>}
              </li>
            </>
          ))}
        </ol>
        <p class="mt-5 text-sm leading-relaxed">
          {t(lang, 'pipeline.caption')}{' '}
          <span class="font-bold text-accent underline underline-offset-4">
            {t(lang, 'pipeline.cta')}
          </span>
        </p>
      </a>
    )}
  </div>

  {facts.length > 0 && (
    <ul class="mt-16 grid gap-6 sm:grid-cols-[repeat(auto-fit,minmax(12rem,1fr))]">
      {facts.map((f) => (
        <li class="leading-snug">
          <span class="heavy block text-3xl tabular-nums">{f.value}</span>
          <span class="text-muted">{f.label}</span>
        </li>
      ))}
    </ul>
  )}
</section>
