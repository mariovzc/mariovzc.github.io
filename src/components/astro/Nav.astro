---
import ThemeToggle from '../react/ThemeToggle';
import { localizePath, otherLocale, t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
  path: string;
  name: string;
  langSwitchHref?: string;
  /** Brand link and theme toggle only (404 page). */
  brandOnly?: boolean;
}

const { lang, path, name, langSwitchHref, brandOnly = false } = Astro.props;
const home = localizePath('/', lang);
const other = otherLocale(lang);
---

<header class="sticky top-0 z-50 bg-bg">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 text-sm font-semibold sm:px-6"
    aria-label="Main"
  >
    <a href={home} class="heavy truncate text-base text-fg">
      {name}
    </a>
    <div class="flex shrink-0 items-center gap-4 sm:gap-6">
      {!brandOnly && (
        <>
          <a href={`${home}#work`} class="hidden hover:text-accent sm:inline">
            {t(lang, 'nav.work')}
          </a>
          <a href={`${home}#about`} class="hidden hover:text-accent sm:inline">
            {t(lang, 'nav.about')}
          </a>
          <a href={`${home}#contact`} class="btn min-h-0 px-4 py-2">
            {t(lang, 'nav.contact')}
          </a>
          <a
            href={langSwitchHref ?? localizePath(path, other)}
            hreflang={other}
            lang={other}
            data-testid="lang-switch"
            class="hover:text-accent"
          >
            {t(lang, 'lang.short')}
            <span class="sr-only"> — {t(lang, 'lang.switchLabel')}</span>
          </a>
        </>
      )}
      <ThemeToggle
        client:load
        labels={{ toLight: t(lang, 'theme.toLight'), toDark: t(lang, 'theme.toDark') }}
      />
    </div>
  </nav>
</header>
