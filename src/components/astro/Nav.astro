---
import ThemeToggle from '../react/ThemeToggle';
import { localizePath, otherLocale, t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
  path: string;
  name: string;
  langSwitchHref?: string;
  /** Brand link and theme toggle only (404 page). */
  brandOnly?: boolean;
}

const { lang, path, name, langSwitchHref, brandOnly = false } = Astro.props;
const home = localizePath('/', lang);
const other = otherLocale(lang);
---

<header class="sticky top-0 z-50 border-b border-line bg-[color-mix(in_srgb,var(--surface)_85%,transparent)] backdrop-blur-[20px]">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 text-sm sm:px-6"
    aria-label="Main"
  >
    <a href={home} class="heavy truncate text-base text-fg">
      {name}
    </a>
    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      {!brandOnly && (
        <>
          <a href={`${home}#work`} class="pill pill-neutral hidden sm:inline-flex">
            {t(lang, 'nav.work')}
          </a>
          <a href={`${home}#about`} class="pill pill-neutral hidden sm:inline-flex">
            {t(lang, 'nav.about')}
          </a>
          <a href={`${home}#contact`} class="pill pill-neutral">
            {t(lang, 'nav.contact')}
          </a>
        </>
      )}
      {!brandOnly && (
        <a
          href={langSwitchHref ?? localizePath(path, other)}
          hreflang={other}
          lang={other}
          data-testid="lang-switch"
          class="pill pill-soft"
        >
          {t(lang, 'lang.short')}
          <span class="sr-only"> — {t(lang, 'lang.switchLabel')}</span>
        </a>
      )}
      <ThemeToggle
        client:load
        labels={{ toLight: t(lang, 'theme.toLight'), toDark: t(lang, 'theme.toDark') }}
      />
    </div>
  </nav>
</header>
