---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { localizePath, t, type Locale } from '../../i18n/utils';
import type { LocalizedProject } from '../../lib/projects';
import type { ProjectEntry } from '../../lib/site-data';

interface Props {
  lang: Locale;
  project: LocalizedProject<ProjectEntry>;
}
const { lang, project } = Astro.props;
const d = project.entry.data;
const href = localizePath(`/projects/${project.slug}/`, lang);
---

<article data-testid="project-card" class="group fade-up">
  <a href={href} class="block" aria-label={`${t(lang, 'projects.view')}: ${d.title}`}>
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <h3
        class="heavy text-[clamp(1.5rem,3.6vw,3.4rem)] leading-none text-balance transition-colors group-hover:text-accent"
        lang={project.contentLang}
      >
        {d.title}
      </h3>
      <span class="font-semibold text-muted">{d.year}</span>
    </div>
    <p class="mt-4 max-w-[58ch] text-lg leading-relaxed" lang={project.contentLang}>
      {d.summary}
    </p>
    {d.confidential && (
      <span
        data-testid="confidential-badge"
        class="mt-3 inline-flex items-center gap-1.5 font-semibold text-chip-orange"
      >
        <Icon name="lock" />
        {t(lang, 'project.confidential')}
      </span>
    )}
    <Image
      src={d.cover}
      alt={d.coverAlt}
      widths={[768, 1152, 2304]}
      sizes="(min-width: 1152px) 1104px, 100vw"
      format="webp"
      class="mt-8 aspect-[16/10] w-full bg-surface object-cover"
      loading="lazy"
    />
    <p class="mt-4 text-muted">{d.stack.join(' · ')}</p>
  </a>
</article>
