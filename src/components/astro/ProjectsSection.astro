---
import ProjectCard from './ProjectCard.astro';
import { t, type Locale } from '../../i18n/utils';
import type { LocalizedProject } from '../../lib/projects';
import type { ProjectEntry } from '../../lib/site-data';

interface Props {
  lang: Locale;
  projects: LocalizedProject<ProjectEntry>[];
}
const { lang, projects } = Astro.props;
---

<section id="work" aria-labelledby="work-title" class="scroll-mt-14">
  <div class="chapter chapter-inner">
    <h2 id="work-title" class="fade-up t-large">
      {t(lang, 'projects.title')}
    </h2>
    <div class="mt-14 flex flex-col gap-24 sm:gap-32">
      {projects.map((p) => (
        <ProjectCard lang={lang} project={p} />
      ))}
    </div>
  </div>
</section>
