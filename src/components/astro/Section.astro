---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-20 border-t border-line py-16">
  <h2 id={`${id}-title`} class="mb-10 font-serif text-3xl sm:text-4xl">
    {title}
  </h2>
  <slot />
</section>
