---
interface Props {
  id: string;
  title: string;
  /** Small uppercase label above the heading. */
  label?: string;
}
const { id, title, label } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="fade-up scroll-mt-20 py-10 sm:py-12">
  {label && <p class="eyebrow mb-2">{label}</p>}
  <h2 id={`${id}-title`} class="heavy mb-6 text-3xl sm:text-4xl">
    {title}
  </h2>
  <slot />
</section>
