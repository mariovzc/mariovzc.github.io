---
import { localizePath, t, type Locale } from '../../i18n/utils';
import type { LocalizedProject } from '../../lib/projects';
import type { ProjectEntry } from '../../lib/site-data';
import type { ProfileData } from '../../lib/types';

interface Props {
  lang: Locale;
  profile: ProfileData;
  projects: LocalizedProject<ProjectEntry>[];
}
const { lang, profile, projects } = Astro.props;
const items = profile.services.map((s) => ({
  ...s,
  proof: projects.find((p) => p.slug === s.project),
  mailto: `mailto:${profile.contact.email}?subject=${encodeURIComponent(`${t(lang, 'services.subject')} ${s.title}`)}`,
}));
// Pick one capability, see its panel: radios + :has(), no JavaScript. Without :has() every panel shows.
const panelCss = items
  .map((_, i) => `.svc:has(#svc-${i}:checked) .svc-p-${i}{display:block}`)
  .join('');
---

<section id="services" aria-labelledby="services-title" class="scroll-mt-14 bg-surface">
  <div class="chapter chapter-inner">
    <h2 id="services-title" class="fade-up t-large max-w-[14em] text-balance">
      {t(lang, 'services.title')}
    </h2>
    <p class="fade-up mt-5 max-w-2xl text-lg text-muted">{t(lang, 'services.hint')}</p>
    <div class="fade-up svc mt-12 grid gap-10 lg:grid-cols-12 lg:gap-14">
      <fieldset class="lg:col-span-6">
        <legend class="sr-only">{t(lang, 'services.title')}</legend>
        <ul class="flex flex-col">
          {items.map((s, i) => (
            <li>
              <label class="svc-opt heavy flex cursor-pointer items-baseline gap-4 py-3 text-[clamp(1.5rem,3.6vw,3.4rem)] leading-none">
                <input
                  type="radio"
                  name="service"
                  id={`svc-${i}`}
                  class="sr-only"
                  checked={i === 0}
                />
                <span aria-hidden="true" class="svc-mark text-accent">
                  →
                </span>
                <span>{s.title}</span>
              </label>
            </li>
          ))}
        </ul>
      </fieldset>
      <div class="lg:col-span-6">
        {items.map((s, i) => (
          <div data-testid="service-panel" class:list={['svc-p bg-bg p-8 sm:p-10', `svc-p-${i}`]}>
            <p class="text-lg leading-relaxed">{s.description}</p>
            {s.tools && (
              <p class="mt-5 leading-relaxed">
                <strong class="font-bold">{t(lang, 'services.tools')}:</strong> {s.tools}
              </p>
            )}
            {s.proof && (
              <p class="mt-3 leading-relaxed">
                <strong class="font-bold">{t(lang, 'services.proof')}:</strong>{' '}
                <a
                  href={localizePath(`/projects/${s.proof.slug}/`, lang)}
                  lang={s.proof.contentLang}
                  class="font-semibold text-accent underline underline-offset-4"
                >
                  {s.proof.entry.data.title}
                </a>
              </p>
            )}
            <a href={s.mailto} class="btn mt-8">
              {t(lang, 'services.cta')}
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
  <style is:inline set:html={panelCss}></style>
</section>

<style>
  .svc-p {
    display: none;
  }
  @supports not selector(:has(*)) {
    .svc-p {
      display: block;
      margin-bottom: 1rem;
    }
  }
  .svc-opt {
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .svc-opt:hover,
  .svc-opt:has(input:checked) {
    color: var(--fg);
  }
  .svc-mark {
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .svc-opt:has(input:checked) .svc-mark {
    opacity: 1;
  }
  .svc-opt:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
</style>
