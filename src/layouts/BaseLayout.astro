---
import '../styles/global.css';
import SEO from '../components/astro/SEO.astro';
import Nav from '../components/astro/Nav.astro';
import Footer from '../components/astro/Footer.astro';
import { LOCALES, t, type Locale } from '../i18n/utils';
import { getProfile, getSiteData } from '../lib/site-data';
import { safeJson } from '../lib/seo';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Unlocalized route, e.g. "/" or "/projects/foo/". */
  path: string;
  translations?: Locale[];
  image?: string;
  jsonLd?: Record<string, unknown>[];
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Language the content is written in (og:locale); defaults to `lang`. */
  contentLang?: Locale;
  /** Overrides the language-switch target (e.g. the 404 page). */
  langSwitchHref?: string;
}

const {
  lang,
  title,
  description,
  path,
  translations = [...LOCALES],
  image = '/og-default.png',
  jsonLd = [],
  type = 'website',
  noindex = false,
  contentLang = lang,
  langSwitchHref,
} = Astro.props;

const profile = await getProfile(lang);
const siteData = await getSiteData(Astro.site!);
const originTrialToken = import.meta.env.PUBLIC_WEBMCP_OT_TOKEN;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {originTrialToken && <meta http-equiv="origin-trial" content={originTrialToken} />}
    <script is:inline>
      // Mirrors resolveTheme() in src/lib/theme.ts. Runs before first paint.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var dark =
          stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <SEO
      lang={lang}
      title={title}
      description={description}
      path={path}
      translations={translations}
      image={image}
      type={type}
      jsonLd={jsonLd}
      noindex={noindex}
      contentLang={contentLang}
    />
  </head>
  <body class="min-h-screen bg-bg text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-surface focus:px-4 focus:py-2 focus:font-semibold focus:shadow-lg"
    >
      {t(lang, 'nav.skip')}
    </a>
    <Nav lang={lang} path={path} name={profile.name} langSwitchHref={langSwitchHref} />
    <main id="main" class="mx-auto max-w-6xl px-4 sm:px-6">
      <slot />
    </main>
    <Footer lang={lang} name={profile.name} />
    <script type="application/json" id="webmcp-data" set:html={safeJson(siteData)} />
    <script>
      import '../scripts/webmcp.ts';
    </script>
  </body>
</html>
