---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/react/ThemeToggle';
import avatar from '../assets/brand/avatar.png';
import { localizePath, otherLocale, t, type Locale } from '../i18n/utils';
import { getProfile } from '../lib/site-data';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const profile = await getProfile(lang);
const other = otherLocale(lang);
const { email, github, linkedin, x, credly } = profile.contact;
const socials = [
  { label: 'GitHub', href: github },
  { label: 'LinkedIn', href: linkedin },
  { label: 'X', href: x },
  { label: 'Credly', href: credly },
].filter((s): s is { label: string; href: string } => Boolean(s.href));
---

<BaseLayout
  lang={lang}
  title={`${profile.name} — ${profile.role}`}
  description={t(lang, 'soon.text')}
  path="/"
  noindex
  minimal
>
  <div class="flex items-center justify-end gap-4 text-sm font-semibold">
    <a
      href={localizePath('/', other)}
      hreflang={other}
      lang={other}
      data-testid="lang-switch"
      class="hover:text-accent"
    >
      {t(lang, 'lang.short')}
      <span class="sr-only"> — {t(lang, 'lang.switchLabel')}</span>
    </a>
    <ThemeToggle
      client:load
      labels={{ toLight: t(lang, 'theme.toLight'), toDark: t(lang, 'theme.toDark') }}
    />
  </div>

  <div class="flex flex-1 items-center py-8">
    <section
      class="hero-surface fade-up w-full px-7 py-14 sm:px-12 sm:py-20"
      data-testid="coming-soon"
    >
      <Image
        src={avatar}
        alt={profile.name}
        width={80}
        height={80}
        densities={[1, 2]}
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="size-20 rounded-full"
      />
      <h1 class="heavy mt-8 text-[clamp(2.4rem,8vw,4.5rem)] leading-none text-balance">
        {t(lang, 'soon.title')}
      </h1>
      <p class="mt-5 max-w-xl text-xl leading-relaxed">
        <strong class="font-bold">{profile.name}</strong>, {profile.role}. {t(lang, 'soon.text')}
      </p>
      <p class="mt-9">
        <a href={`mailto:${email}`} class="btn btn-ink px-6 py-3 text-base break-all">
          {email}
        </a>
      </p>
      {socials.length > 0 && (
        <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 font-bold">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                rel="me noopener"
                target="_blank"
                class="underline underline-offset-4"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>
