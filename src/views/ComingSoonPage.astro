---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/react/ThemeToggle';
import avatar from '../assets/brand/avatar.png';
import { localizePath, otherLocale, t, type Locale } from '../i18n/utils';
import { getProfile } from '../lib/site-data';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const profile = await getProfile(lang);
const other = otherLocale(lang);
const { email, github, linkedin, x, credly } = profile.contact;
const socials = [
  { label: 'GitHub', href: github },
  { label: 'LinkedIn', href: linkedin },
  { label: 'X', href: x },
  { label: 'Credly', href: credly },
].filter((s): s is { label: string; href: string } => Boolean(s.href));
---

<BaseLayout
  lang={lang}
  title={`${profile.name} — ${profile.role}`}
  description={t(lang, 'soon.text')}
  path="/"
  noindex
  minimal
>
  <div class="flex items-center justify-end gap-2 text-sm">
    <a
      href={localizePath('/', other)}
      hreflang={other}
      lang={other}
      data-testid="lang-switch"
      class="pill pill-soft"
    >
      {t(lang, 'lang.short')}
      <span class="sr-only"> — {t(lang, 'lang.switchLabel')}</span>
    </a>
    <ThemeToggle
      client:load
      labels={{ toLight: t(lang, 'theme.toLight'), toDark: t(lang, 'theme.toDark') }}
    />
  </div>

  <div class="flex flex-1 items-center py-8">
    <section
      class="hero-surface fade-up relative w-full overflow-hidden rounded-block px-7 py-12 text-center sm:px-12 sm:py-16"
      data-testid="coming-soon"
    >
      <span
        class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full border border-black/10"
        aria-hidden="true"
      ></span>
      <span
        class="pointer-events-none absolute -bottom-32 -left-16 size-80 rounded-full border border-black/10"
        aria-hidden="true"
      ></span>
      <div class="relative flex flex-col items-center">
        <Image
          src={avatar}
          alt={profile.name}
          width={96}
          height={96}
          densities={[1, 2]}
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="size-24 rounded-full border-2 border-black/20 shadow-lg"
        />
        <p class="mt-6 text-xs font-bold uppercase tracking-[0.14em]">{profile.role}</p>
        <h1 class="heavy mt-3 text-4xl leading-[1.05] sm:text-6xl">{profile.name}</h1>
        <p class="pill pill-white mt-6 px-4 py-1.5 text-sm">{t(lang, 'soon.eyebrow')}</p>
        <p class="heavy mt-6 text-2xl sm:text-3xl">{t(lang, 'soon.title')}</p>
        <p class="mt-3 max-w-xl text-lg">{t(lang, 'soon.text')}</p>
        <ul class="mt-8 flex flex-wrap justify-center gap-2">
          <li>
            <a href={`mailto:${email}`} class="pill pill-white break-all">
              {email}
            </a>
          </li>
          {socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" class="pill pill-outline-white">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
