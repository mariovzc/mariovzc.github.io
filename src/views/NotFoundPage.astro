---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/brand/avatar.png';
import { localizePath, t, type Locale } from '../i18n/utils';
import { getProfile } from '../lib/site-data';

const profile = await getProfile('en');
const { email } = profile.contact;
const blocks: { lang: Locale; fallback: string }[] = [
  { lang: 'en', fallback: '/page' },
  { lang: 'es', fallback: '/página' },
];
---

<BaseLayout
  lang="en"
  title={`${t('en', 'notFound.title')} — 404`}
  description={t('en', 'notFound.text')}
  path="/404/"
  translations={['en']}
  noindex
  brandOnlyNav
>
  <section class="mx-auto flex w-full max-w-[640px] flex-col items-center gap-8 py-12 sm:py-20">
    <div
      class="tile-dark w-full overflow-hidden p-5 font-mono text-sm leading-relaxed sm:p-6"
      data-testid="not-found-terminal"
    >
      <div class="mb-4 flex gap-2" aria-hidden="true">
        <span class="size-3 rounded-full bg-[#ff5f57]"></span>
        <span class="size-3 rounded-full bg-[#febc2e]"></span>
        <span class="size-3 rounded-full bg-[#28c840]"></span>
      </div>
      {blocks.map((b) => (
        <div data-lang={b.lang} lang={b.lang}>
          <p class="flex min-w-0 gap-2">
            <span class="shrink-0 text-[#4ade80]">$</span>
            <span class="shrink-0">cd</span>
            <span class="min-w-0 truncate" data-nf-path>
              {b.fallback}
            </span>
          </p>
          <p class="text-[#a1a1a6]">cd: no such file or directory</p>
        </div>
      ))}
      <p class="mt-1 flex gap-2">
        <span class="shrink-0 text-[#4ade80]">$</span>
        <span>git checkout home</span>
      </p>
      <p class="caret mt-1" aria-hidden="true">
        ▌
      </p>
    </div>

    <Image
      src={avatar}
      alt=""
      aria-hidden="true"
      width={88}
      height={88}
      densities={[1, 2]}
      format="webp"
      class="size-[88px] rounded-full border-2 border-line shadow-lg"
    />

    <div class="flex w-full flex-col gap-10 text-center">
      {blocks.map((b) => (
        <div data-lang={b.lang} lang={b.lang}>
          <p class="eyebrow">404</p>
          <h1 class="heavy mt-3 text-4xl sm:text-5xl">{t(b.lang, 'notFound.title')}</h1>
          <p class="mt-4 text-lg text-muted">{t(b.lang, 'notFound.text')}</p>
          <p class="mt-8 flex flex-wrap justify-center gap-3">
            <a href={localizePath('/', b.lang)} class="pill pill-accent px-5 py-2.5">
              {t(b.lang, 'notFound.home')}
            </a>
            <a href={`mailto:${email}`} class="pill pill-soft px-5 py-2.5">
              {t(b.lang, 'nav.contact')}
            </a>
          </p>
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    // Mirrors notFoundLang() in src/lib/not-found.ts. Without JS both languages stay visible.
    (function () {
      var p = location.pathname;
      var es = p === '/es' || p.indexOf('/es/') === 0;
      document.querySelectorAll('[data-lang]').forEach(function (el) {
        el.hidden = el.getAttribute('data-lang') !== (es ? 'es' : 'en');
      });
      document.querySelectorAll('[data-nf-path]').forEach(function (el) {
        el.textContent = p;
      });
    })();
  </script>
  <style>
    .caret {
      color: #4ade80;
    }
    @media (prefers-reduced-motion: no-preference) {
      .caret {
        animation: nf-blink 1.1s steps(1) infinite;
      }
    }
    @keyframes nf-blink {
      50% {
        opacity: 0;
      }
    }
  </style>
</BaseLayout>
