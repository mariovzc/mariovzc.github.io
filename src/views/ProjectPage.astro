---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageGallery from '../components/react/ImageGallery';
import Icon from '../components/astro/Icon.astro';
import { localizePath, t, type Locale } from '../i18n/utils';
import { adjacentProjects, type LocalizedProject } from '../lib/projects';
import { getProfile, toSummary, type ProjectEntry } from '../lib/site-data';
import { projectJsonLd } from '../lib/seo';

interface Props {
  lang: Locale;
  project: LocalizedProject<ProjectEntry>;
  all: LocalizedProject<ProjectEntry>[];
}

const { lang, project, all } = Astro.props;
const d = project.entry.data;
const { Content } = await render(project.entry);
const profile = await getProfile(lang);
// On fallback pages the JSON-LD url is the canonical (content-language) URL.
const summary = toSummary({ ...project, lang: project.contentLang }, Astro.site!);
const { prev, next } = adjacentProjects(all, project.slug);
const og = await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'png' });
const gallery = await Promise.all(
  d.gallery.map(async (g) => {
    const thumb = await getImage({ src: g.src, width: 800, format: 'webp' });
    const full = await getImage({ src: g.src, width: 1600, format: 'webp' });
    return {
      thumb: thumb.src,
      full: full.src,
      alt: g.alt,
      width: Number(thumb.attributes.width ?? 800),
      height: Number(thumb.attributes.height ?? 500),
    };
  }),
);
const projectHref = (slug: string) => localizePath(`/projects/${slug}/`, lang);
---

<BaseLayout
  lang={lang}
  title={`${d.title} — ${profile.name}`}
  description={d.summary}
  path={`/projects/${project.slug}/`}
  translations={project.translations}
  image={og.src}
  type="article"
  contentLang={project.contentLang}
  jsonLd={[projectJsonLd(summary, profile)]}
>
  <article class="py-10 sm:py-14">
    <a
      href={`${localizePath('/', lang)}#work`}
      class="font-bold underline underline-offset-4 hover:text-accent"
    >
      ← {t(lang, 'project.back')}
    </a>

    {project.isFallback && (
      <p
        data-testid="fallback-notice"
        class="mt-8 bg-chip-orange-bg px-5 py-3 font-semibold text-chip-orange"
      >
        {t(lang, 'project.fallbackNotice')}
      </p>
    )}

    <div>
      <h1
        lang={project.contentLang}
        class="heavy mt-8 max-w-[18ch] text-[clamp(2.2rem,5.4vw,4.5rem)] leading-[0.98] text-balance"
      >
        {d.title}
      </h1>
      <p lang={project.contentLang} class="mt-6 max-w-2xl text-xl leading-relaxed">
        {d.summary}
      </p>

      {d.confidential && (
        <p
          data-testid="confidential-notice"
          class="mt-6 flex max-w-2xl items-start gap-2 bg-chip-orange-bg px-5 py-3 font-semibold text-chip-orange"
        >
          <Icon name="lock" />
          <span>{t(lang, 'project.confidentialNotice')}</span>
        </p>
      )}

      <dl class="mt-10 grid gap-x-10 gap-y-5 sm:grid-cols-3">
        <div>
          <dt class="font-bold">{t(lang, 'project.year')}</dt>
          <dd class="mt-1 text-lg text-muted">{d.year}</dd>
        </div>
        <div>
          <dt class="font-bold">{t(lang, 'project.role')}</dt>
          <dd lang={project.contentLang} class="mt-1 text-lg text-muted">
            {d.role}
          </dd>
        </div>
        <div>
          <dt class="font-bold">{t(lang, 'project.stack')}</dt>
          <dd class="mt-1 text-lg text-muted">{d.stack.join(' · ')}</dd>
        </div>
      </dl>

      {(d.links.live || d.links.repo) && (
        <p class="mt-8 flex flex-wrap items-center gap-6">
          {d.links.live && (
            <a
              href={d.links.live}
              data-testid="project-live"
              target="_blank"
              rel="noopener"
              class="btn"
            >
              {t(lang, 'project.live')} ↗
            </a>
          )}
          {d.links.repo && (
            <a
              href={d.links.repo}
              data-testid="project-repo"
              target="_blank"
              rel="noopener"
              class="font-bold underline underline-offset-4 hover:text-accent"
            >
              {t(lang, 'project.repo')} ↗
            </a>
          )}
        </p>
      )}

      <Image
        src={d.cover}
        alt={d.coverAlt}
        widths={[800, 1600]}
        sizes="(min-width: 1152px) 1104px, 100vw"
        class="mt-12 w-full bg-surface"
        format="webp"
        loading="eager"
      />

      <div lang={project.contentLang} class="prose-content mt-14 max-w-[68ch] text-lg">
        <Content />
      </div>

      {gallery.length > 0 && (
        <section data-testid="project-gallery" class="mt-16">
          <h2 class="heavy mb-6 text-3xl">{t(lang, 'project.gallery')}</h2>
          <ImageGallery
            client:visible
            images={gallery}
            labels={{ open: t(lang, 'gallery.open'), close: t(lang, 'gallery.close') }}
          />
        </section>
      )}
    </div>

    <section
      data-testid="project-cta"
      aria-labelledby="project-cta-title"
      class="hero-surface mt-16 flex flex-wrap items-center justify-between gap-8 px-7 py-12 sm:px-12 sm:py-14"
    >
      <div class="max-w-xl">
        <h2 id="project-cta-title" class="heavy text-3xl sm:text-4xl">
          {t(lang, 'project.cta.title')}
        </h2>
        <p class="mt-3 text-lg">{t(lang, 'project.cta.text')}</p>
      </div>
      <a
        href={`mailto:${profile.contact.email}?subject=${encodeURIComponent(`${t(lang, 'project.cta.subject')} ${d.title}`)}`}
        class="btn btn-ink px-6 py-3 text-base"
      >
        {t(lang, 'project.cta.button')}
      </a>
    </section>

    <nav class="mt-16 grid gap-6 sm:grid-cols-2" aria-label={t(lang, 'project.navLabel')}>
      {prev ? (
        <a href={projectHref(prev.slug)} data-testid="project-prev" class="group block">
          <span class="font-semibold text-muted">← {t(lang, 'project.prev')}</span>
          <span
            lang={prev.contentLang}
            class="heavy mt-1 block text-xl transition-colors group-hover:text-accent"
          >
            {prev.entry.data.title}
          </span>
        </a>
      ) : (
        <span class="hidden sm:block"></span>
      )}
      {next && (
        <a href={projectHref(next.slug)} data-testid="project-next" class="group block text-right">
          <span class="font-semibold text-muted">{t(lang, 'project.next')} →</span>
          <span
            lang={next.contentLang}
            class="heavy mt-1 block text-xl transition-colors group-hover:text-accent"
          >
            {next.entry.data.title}
          </span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
